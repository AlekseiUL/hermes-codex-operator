{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hermes-codex-operator/work-contract-v1.schema.json",
  "title": "Hermes Codex Operator WorkContract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "operation_id",
    "workspace",
    "prompt",
    "allowed_change_globs",
    "verification",
    "timeout_seconds"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 262144,
      "pattern": "\\S"
    },
    "allowed_change_globs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 128,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "model": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+\\-]*$"
    },
    "reasoning_effort": {
      "enum": [null, "none", "minimal", "low", "medium", "high", "xhigh"]
    }
  }
}
